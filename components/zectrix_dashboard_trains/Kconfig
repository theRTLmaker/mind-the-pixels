menu "Dashboard trains"

config ZECTRIX_TRAINS_RDM_API_KEY
    string "Rail Data Marketplace API key"
    default ""
    help
        Consumer key for the Rail Data Marketplace "Live Departure Board -
        Staff Version" product. Leave empty to use the public Huxley server
        only. Lives in the gitignored sdkconfig; never commit it.

config ZECTRIX_TRAINS_RDM_URL
    string "Rail Data Marketplace departures base URL"
    default "https://api1.raildata.org.uk/1010-live-departure-board---staff-version1_0/LDBSVWS/api/20220120/GetDepBoardWithDetails"
    help
        GetDepBoardWithDetails endpoint without the trailing /{crs}/{time}.
        The firmware appends /SFA/<yyyymmddThhmmss> and a query filtered to
        trains calling at St Pancras (STP).

endmenu
